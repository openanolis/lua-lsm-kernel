# Minimal CI kernel for the lua-lsm functional matrix.
# Merged on top of x86_64 defconfig; all guest drivers are built in so
# the rootfs needs no modules. Keep this list small: it is a functional
# smoke kernel, not a debug/perf kernel.

CONFIG_SECURITY=y
CONFIG_SECURITY_LUA_LSM=y
CONFIG_SECURITY_LUA_LSM_STATS=y
CONFIG_SECURITYFS=y
CONFIG_LSM="yama,lua"

CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-lua-ci"

# The boot-time W+X audit trips on eIBRS+ITS hosts (e.g. Xeon 6975P):
# an ITS thunk page in module space is still W+X when ptdump runs, and
# panic_on_warn=1 turns that into a boot panic. This is a base-kernel
# issue unrelated to lua-lsm; keep the audit out of the smoke kernel.
CONFIG_DEBUG_WX=n

CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_EXT4_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_BINFMT_SCRIPT=y